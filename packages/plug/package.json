{
  "name": "dsh-editor-plug",
  "version": "3.0.0",
  "description": "Editor-side SDK for dsh-editor-socket: plug client and local socket discovery.",
  "type": "module",
  "license": "MIT",
  "author": "YMOOSE <42179813+YMoose@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YMoose/dsh-editor-socket.git",
    "directory": "packages/plug"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./plug": {
      "development": {
        "types": "./src/plug.ts",
        "default": "./src/plug.ts"
      },
      "types": "./lib/types/plug.d.ts",
      "default": "./lib/plug.js"
    },
    "./discovery": {
      "development": {
        "types": "./src/discovery.ts",
        "default": "./src/discovery.ts"
      },
      "types": "./lib/types/discovery.d.ts",
      "default": "./lib/discovery.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dsh-editor-protocol": "^3.0.0"
  }
}
